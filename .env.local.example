# Copy to .env.local and fill in.

# ── Appwrite ────────────────────────────────────────────────────────────────
# This project uses Appwrite Cloud, fra region. A self-hosted instance works
# too — only the endpoint changes.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server only. Must NEVER be prefixed NEXT_PUBLIC_ — that ships it to browsers.
# Create one in the console under Overview → Integrations → API keys, or with
#   appwrite project create-key --project-id <id> --name "mega-church server" \
#     --scopes users.read users.write sessions.write databases.read \
#              databases.write collections.read collections.write \
#              attributes.read attributes.write indexes.read indexes.write \
#              documents.read documents.write files.read files.write \
#              buckets.read buckets.write
APPWRITE_API_KEY=

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# ── Fingerprint ─────────────────────────────────────────────────────────────
# Where the BROWSER looks for the local scanner bridge. Only needs changing if
# the bridge was installed on a non-default port.
# NEXT_PUBLIC_CHURCH_BRIDGE_URL=http://127.0.0.1:7788

# Where the SERVER sends probes to be matched. Set this ONLY when the app runs
# on the same machine as the bridge. Leave it unset on a hosted deployment —
# the bridge binds to loopback, so a hosted server can never reach it, and with
# this unset the server matches in-process using public/nbis/ instead.
# CHURCH_BIOMETRIC_MATCHER_URL=http://127.0.0.1:7788

# bozorth3 score at or above which a match is accepted. Default 33. Read the
# provenance comment in lib/biometrics/matching.ts before changing it.
# CHURCH_BIOMETRIC_THRESHOLD=33

# Score at or above which identification stops searching, instead of scoring
# the whole gallery and taking the highest. Default: the threshold x 2.
# Raising it very high (9999) disables the early exit entirely.
CHURCH_BIOMETRIC_DECISIVE=

# Emergency switch: "0" disables the in-process WebAssembly matcher. Read per
# request, so it takes effect without a restart.
# CHURCH_WASM_MATCHER=1

# ── Notifications (PWA push) ────────────────────────────────────────────────
# Web Push needs a VAPID key pair. Generate one ONCE, per deployment:
#
#   npx web-push generate-vapid-keys
#
# Rotating these invalidates every device that has already subscribed — the
# whole birthday team has to press "Turn on" again — so keep the pair rather
# than regenerating it casually.
#
# The public key is public by design: the browser hands it to the push service.
# The private key proves the sender is you, and must NEVER be prefixed
# NEXT_PUBLIC_. Without both, the birthdays page says notifications are not
# configured rather than showing a button that fails on click.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Where a push service should complain if this sender misbehaves. REQUIRED —
# there is deliberately no default, because the one that used to be here
# (mailto:admin@megachurch.local) is exactly the bug this note exists to
# prevent.
#
# Apple VALIDATES this address and FCM does not. A subject on a reserved
# domain — .local, .test, .internal, example.com — makes every Apple send fail
# with 403 BadJwtToken while every Android send succeeds, so the system looks
# healthy from the only side anyone was watching. It is not even pruned as a
# dead subscription, because 403 is not 410: the iPhone stays on the list,
# listed as live, receiving nothing.
#
# Use the site itself, or a mailto: on a domain that really resolves.
VAPID_SUBJECT=https://mega-church.vercel.app

# Shared secret for the scheduled birthday run. Any scheduler may call
#   POST /api/notifications/birthday-run
#   Authorization: Bearer <this value>
# and it will push TOMORROW's birthdays to the team. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave it unset and only a signed-in admin can trigger a run by hand.
NOTIFICATIONS_CRON_SECRET=

# ── Seed accounts (npm run seed:users) ──────────────────────────────────────
# A role whose pair is left blank is skipped.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USHER_EMAIL=
SEED_USHER_PASSWORD=
SEED_KIOSK_EMAIL=
SEED_KIOSK_PASSWORD=
# A TEMPLATE head account. The church needs one per constituency/bacenta head —
# create the rest in the Appwrite console with the same `leader` label, then
# appoint each from its group's page. What a head can see comes from being
# named as head, never from the label alone.
SEED_LEADER_EMAIL=
SEED_LEADER_PASSWORD=
# The team that makes the birthday flyers and shoutouts.
SEED_CELEBRATIONS_EMAIL=
SEED_CELEBRATIONS_PASSWORD=

# A shepherd: reads everything, writes nothing.
SEED_SHEPHERD_EMAIL=
SEED_SHEPHERD_PASSWORD=

# --- mNotify bulk SMS -------------------------------------------------------
# Birthday wishes to the celebrant, and tithe thank-yous. Both OPTIONAL: with
# them absent every SMS screen says "SMS is not set up" rather than offering a
# button that fails.
#
# The key comes from Developer in the mNotify dashboard. The sender ID has to
# be REQUESTED there and approved — 11 characters or fewer — and an unapproved
# one is accepted by the API and then silently never delivered, which is why a
# blank sender is treated as "not configured" rather than defaulted.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=

# Set to 1 to swap the real provider for a stub that records and sends nothing.
# This is what keeps a test run from spending the church's SMS credit.
SMS_STUB=
